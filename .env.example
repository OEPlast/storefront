# =============================================================================
# Rawura — STOREFRONT (customer-facing Next.js 15 app)
# =============================================================================
# Dev server:  npm run dev   ->  http://localhost:3009   (-p 3009 is in package.json)
# Prod:        npm run build && npm start
#              WARNING: "next start" has NO -p flag, so prod defaults to port 3000
#              — the same port Main-server uses below. On a single host run
#              `npm start -- -p 3009` (or set PORT=3009) or the two collide.
#
# Setup:
#   cp .env.example .env      then fill in every REQUIRED value below.
#
# Minimum to boot at all:  NEXT_PUBLIC_API_URL, MONGODB_URI, AUTH_SECRET.
# Also required for full function:  REVALIDATE_SECRET (admin edits reach the site),
#   AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET (Google sign-in),
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (GIG door delivery at checkout).
#
# Boot order — start these BEFORE the storefront or pages will render errors:
#   1. Main-server (REST API)   default http://localhost:3000  -> NEXT_PUBLIC_API_URL
#   2. WebSocket service        default http://localhost:3003  -> NEXT_PUBLIC_WEBSOCKET_URL
#   3. MongoDB Atlas reachable                                 -> MONGODB_URI
#
# -----------------------------------------------------------------------------
# !! PUBLIC-BY-DESIGN WARNING !!
# Every NEXT_PUBLIC_* var is INLINED INTO THE BROWSER BUNDLE at build time.
# Its value is world-readable in page source / devtools. NEVER put a secret,
# a private API key, or anything you would not print on the homepage into a
# NEXT_PUBLIC_* var. Restrict such keys at the provider instead (see the
# Google Maps entry). Vars WITHOUT the prefix are server-only and stay secret.
# Changing any NEXT_PUBLIC_* value requires a REBUILD, not just a restart.
# -----------------------------------------------------------------------------


# ---- Core ----

# Node environment. DO NOT SET THIS. Next.js assigns it itself per command
# (dev -> development, build/start -> production) and warns on a non-standard
# value; pinning it here can make `next build` emit a development build.
# Left commented deliberately — the live .env does not set it either.
# Code branches on it in libs/api/* and libs/dbClient.ts (dev keeps a global
# MongoClient so it survives HMR).
# NODE_ENV=development

# Base URL of Main-server's REST API. Every data fetch hangs off this:
# libs/apiRoutes.ts, libs/api/axios.ts, libs/api/serverAPI.ts,
# libs/query/server-api-client.ts, hooks/queries/*, useValidateCoupon.
# REQUIRED — apiRoutes.ts and the axios instances have NO fallback: if unset,
# every request targets "undefined/..." and the site loads no data at all.
# No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Canonical public origin of the storefront. Read by next.config.js (apex -> www
# 301 redirect) and src/config/siteConfig.ts (canonical URLs, OG/SEO metadata).
# OPTIONAL — falls back to https://www.rawura.com in BOTH places.
# NOTE — currently MISSING from .env, so local builds emit production canonicals.
# WARNING: next.config.js derives APEX_HOST by stripping "www." from this host.
# A value without the www prefix makes apex === canonical (the config guards
# against that and disables the rule); a wrong value is a permanent 301 loop that
# browsers cache. Leave unset locally, or point it at the localhost origin.
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3009

# Brand name shown before the Main-server branding fetch resolves, and if that
# fetch fails (src/libs/storeBranding.ts).
# OPTIONAL — falls back to the literal string 'Rawura'.
NEXT_PUBLIC_STORE_NAME=Rawura


# ---- Database ----

# MongoDB Atlas connection string. Used ONLY by the Auth.js MongoDB adapter
# (src/libs/dbClient.ts -> auth.ts) for auth accounts/users — product and order
# data comes from Main-server over HTTP, not from here.
# REQUIRED — dbClient.ts THROWS at import time if unset, so the app cannot boot.
# Note: the client hardcodes dbName "MyDatabaseName", overriding the database
# segment of this URI.
# Get it from: MongoDB Atlas -> Cluster -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/<database>


# ---- Auth & secrets (server-only — never prefix these with NEXT_PUBLIC_) ----

# Auth.js v5 (next-auth beta) signing/encryption secret for JWT sessions.
# Not read via process.env anywhere in src/ — Auth.js picks it up by name.
# REQUIRED. Auth.js throws MissingSecret and every /api/auth/* route 500s
# without it; set it locally too, not just in production.
# Generate a NEW one per environment — never reuse the prod value in dev.
# Rotating it invalidates all existing sessions (everyone is signed out).
AUTH_SECRET=<base64 32 bytes — generate with: openssl rand -base64 32>

# Google OAuth credentials, picked up automatically by Auth.js v5 through its
# AUTH_<PROVIDER>_ID / _SECRET convention (setEnvDefaults backfills the provider).
# REQUIRED for "Continue with Google"; omit both to disable that button only.
# Get them from: Google Cloud Console -> APIs & Services -> Credentials
#   -> OAuth 2.0 Client ID (Web application).
# Authorized redirect URI (dev): http://localhost:3009/api/auth/callback/google
AUTH_GOOGLE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CODE/ENV NAME MISMATCH (informational — do NOT set these) ---
# auth.ts:32-33 reads process.env.GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, which
# are absent from .env and evaluate to undefined. Harmless today: Auth.js then
# applies `provider.clientId ??= AUTH_GOOGLE_ID`, so the AUTH_GOOGLE_* pair above
# is what actually authenticates. Defining GOOGLE_CLIENT_ID here would silently
# take precedence over AUTH_GOOGLE_ID. Prefer deleting the reads in auth.ts over
# adding these vars.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ---- Storage / CDN ----

# Bunny CDN pull-zone base URL for all product/review imagery.
# Read by src/libs/cdn-url.ts (every app image URL) and, separately and
# self-contained because it runs on the Edge runtime, by
# src/app/api/og/route.tsx (Open Graph image generation) — both must agree.
# OPTIONAL — both call sites fall back to https://oeptest.b-cdn.net/
# A trailing slash is appended automatically if omitted.
# WARNING: next.config.js `images.remotePatterns` HARDCODES oeptest.b-cdn.net.
# Point this at another host and every next/image render fails until you add that
# hostname to remotePatterns as well.
# This is a public pull-zone hostname, not a credential — the Bunny API key is
# never needed here; uploads happen on Main-server.
# Get it from: bunny.net dashboard -> Delivery / CDN -> Pull Zones -> your zone
#   -> the "<zone>.b-cdn.net" hostname (or your custom CNAME). Include https://
NEXT_PUBLIC_CDN_BASE_URL=https://<pull-zone>.b-cdn.net/


# ---- Integrations (third-party) ----

# Google Maps API key used to turn the checkout address into lat/lng coordinates
# for GIG Logistics delivery quoting.
# Read by src/hooks/useCheckoutController.ts (Geocoding fetch) and
# src/components/Checkout/AddressForm.tsx (Places Autocomplete).
#
# REQUIRED for GIG delivery — currently MISSING from .env.
# Consequence: the Geocoding call returns REQUEST_DENIED, the controller takes
# its generic not-found branch and shows "Address not found. Please enter a valid
# address.", coordinates stay undefined, and the GIG shipping quote never fires —
# GIG delivery becomes permanently unselectable with no hint that a missing key
# is the cause. Door-delivery checkout is effectively broken without it.
#
# Get it from: Google Cloud Console -> APIs & Services -> Credentials -> API key.
# Enable BOTH "Geocoding API" and "Places API" on the project.
#
# SECURITY: this is a NEXT_PUBLIC_ var — the key ships inside the browser bundle
# and is visible to anyone. Unavoidable for a browser Maps key, so lock it down
# on Google's side:
#   - Application restriction: HTTP referrers, e.g.
#       http://localhost:3009/*   and   https://www.rawura.com/*
#   - API restriction: Geocoding API + Places API only.
#   - Set a daily quota cap so a scraped key cannot run up the bill.
# Use a SEPARATE key per environment; never reuse an unrestricted server-side key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<browser API key, starts with AIzaSy, ~39 chars>


# ---- Cross-service ----

# Shared secret proving an incoming POST /api/revalidate-branding really came
# from Main-server. The route (src/app/api/revalidate-branding/route.ts) compares
# it to the X-Revalidate-Secret header, then busts the 'branding' cache tag;
# store branding is otherwise cached indefinitely.
# REQUIRED — if unset the route 401s EVERY call, so store-name and WhatsApp-number
# edits made in admin never reach the storefront.
# Get it from: the sibling Main-server repo's own .env, key REVALIDATE_SECRET.
# It MUST be byte-identical there and here — generate once, paste into both.
# No trailing whitespace: the route does an exact string compare on the header.
REVALIDATE_SECRET=<64-char-hex — generate with: openssl rand -hex 32>

# Socket.IO origin of the realtime product-sync service (live price/stock
# updates). Read by src/libs/productSocketSingleton.ts.
# OPTIONAL — falls back to http://localhost:3003.
# NOTE — currently MISSING from .env; it works locally only because that fallback
# happens to match the dev port. In any deployed environment the unset value
# points each visitor's browser at its own localhost:3003, the socket never
# connects, and product cards silently stop receiving live updates.
# No trailing slash; use an https:// origin (wss upgrade) in production.
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:3003


# ---- Unused (present in .env, read by NO code) ----

# NEXT_PUBLIC_SITE_URL — DEAD. Nothing in src/, auth.ts, middleware.ts or
# next.config.js reads it. Almost certainly a mis-named twin of
# NEXT_PUBLIC_MAIN_SITE_URL, which IS read and IS missing from .env. Delete it
# and set NEXT_PUBLIC_MAIN_SITE_URL instead.
# NEXT_PUBLIC_SITE_URL=http://localhost:3009
